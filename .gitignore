# ---- Python 环境 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 密钥与本地配置（绝对不能提交）----
.env
.env.*.local
.env.bak.*
*.pem

# ---- 向量库与缓存（可由 `python -m rag.cli build` 重建，勿提交）----
rag/chroma_db/
rag/cache/
rag/course_cache/
rag/policy_cache/
rag/exam_cache/

# ---- 课程教材原文（受版权保护，用 COURSE_TEXTBOOK 指向本机文件）----
rag/course_data/

# ---- 数据政策汇编（用 POLICY_DOC 指向本机文件）----
rag/policy_data/

# ---- 试卷库题库原文（用 EXAM_TEACHER_DOC / EXAM_STUDENT_DOC 指向本机文件）----
rag/exam_data/

# ---- 原始知识库资料（默认不公开）----
# nlp_/ 内含已发表期刊论文（受版权保护）与内部私密材料（答辩点评、规范等），
# 默认不上传。如确认可公开/私有仓库内部分享，删除下面这行并评估版权。
nlp_/

# ---- 真实用户对话数据（含用户ID/省市/论文医疗等敏感话题，绝不提交）----
data_benchmark/

# ---- 本地 Claude Code 配置 ----
.claude/

# ---- macOS ----
.DS_Store

# ---- 本机部署文件（仅服务器使用，勿提交）----
Dockerfile
docker-compose.yml
.dockerignore
rag/chroma_db.orig/


speed_test_report.txt
speed_test_report.json
speed_test_report.txt.tmp

# ---- 判例库 / 名言库：输出缓存与原始资料（用 CASE_DOC / QUOTE_DOC 指向本机文件）----
rag/case_cache/
rag/quote_cache/
rag/case_data/
rag/quote_data/
rag/case_store/
rag/quote_store/

# ---- 评测数据：eval_data 只跟踪输入题库；评测产物一律不入库 ----
# 新增输入文件时在此追加 ! 行
rag/eval_data/*
!rag/eval_data/testset.json
!rag/eval_data/router_eval.json
!rag/eval_data/router_eval_cases_quotes.json
!rag/eval_data/router_eval_policy.json
!rag/eval_data/course_recall_gold.json

# ---- 日志与空库备份 ----
*.log
rag/chroma_db.empty_bak/

# ---- 调用日志（含用户真实问答全文，public 仓库绝不能进）----
logs/

# 问答永久记录（SQLite，含用户提问与回答，不入库）；只忽略仓库根的 data/，不影响 rag/web/data/
/data/
