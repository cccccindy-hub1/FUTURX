# 复制为 .env 并填入真实值（.env 会被 git 忽略，勿提交）

# ---- 生成层（OpenAI 兼容协议，默认 DeepSeek，可换成 OpenAI / 智谱 / 通义等）----
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 思考链开关：none 关闭（首字节 32s -> 3s）；留空则沿用上游默认
LLM_REASONING_EFFORT=none
# LLM_TIMEOUT=120

# ---- HTTP 对外接口（OpenAI 兼容层）----
# 逗号分隔的密钥；留空=不鉴权（仅本机/内网裸跑时可留空）
# API_KEYS=sk-futurx-xxxx
# 按人发 key（一个班上千个）时改用文件：每行一个 key，# 开头为注释。
# 与 API_KEYS 同时配置时取并集。文件请放在项目目录之外并设 600 权限。
# 生成：python scripts/gen_api_keys.py --count 1000 --keys-file /etc/futurx/api_keys.txt
# API_KEYS_FILE=/etc/futurx/api_keys.txt
# API_MODEL_NAME=ai-li-teacher   # 客户端 model 字段填这个名字

# ---- 可选调参 ----
# EMBED_MODEL=BAAI/bge-m3
# TOP_K=4
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# RAG_DATA_DIR=./nlp_          # 原始资料目录（不存在或为空时 build 直接报错）
# SNAPSHOT_KEEP=2              # build 前保留的库快照份数，存放于 rag/cache/snapshots/

# ---- 检索增强（默认关闭，保持原有纯向量检索行为；按需开启）----
# RETRIEVAL_MODE=dense        # dense=纯向量（默认） | bm25=纯关键词 | hybrid=RRF 融合
# FETCH_K=20                  # 融合前各路召回的候选数
# RRF_K=60                    # RRF 融合常数
# RERANK_ENABLED=false        # true 时启用 bge-reranker-v2-m3 重排序（首次会下载 ~2.3GB）
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOP_N=8
# MAX_DISTANCE=0.0            # >0 时丢弃余弦距离过大的片段（如 0.5）

# ---- 查询增强（需配置 LLM_API_KEY；默认关闭）----
# QUERY_REWRITE_ENABLED=false # true 时用 LLM 把问题改写成检索友好查询
# HYDE_ENABLED=false          # true 时用 HyDE（先生成假设答案再检索）
# REWRITE_MODEL=              # 改写/HyDE 用的小模型，默认同 LLM_MODEL

# ---- 父子分块（默认关闭；子块入库检索、父块作生成上下文）----
# PARENT_CHILD_ENABLED=false  # 建库时开启：小 chunk 入向量库，父块存 sidecar
# PARENT_SIZE=1500            # 父块字符数上限
# CONTEXT_EXPAND_ENABLED=false# 查询时开启：命中子块后展开为父块上下文

# ---- Contextual Retrieval（建库时 LLM 为每个 chunk 写上下文，提升召回；默认关闭）----
# 开启后每个新 chunk 一次 LLM 调用（结果缓存，内容不变的重建不再调用），需要 LLM_API_KEY
# CONTEXTUAL_ENABLED=false
# CONTEXTUAL_MODEL=           # 默认同 REWRITE_MODEL / LLM_MODEL，建议用便宜的小模型
# CONTEXTUAL_DOC_MAX_CHARS=6000
# CONTEXTUAL_WORKERS=4

# ---- data_benchmark 评测（默认读取 <项目根>/data_benchmark）----
# BENCHMARK_DIR=              # 数据目录
# BENCHMARK_SEED=42           # 切分随机种子（固定以保证可复现）
# TEST_SIZE=0.08              # 测试集占比下限（报告建议 7~8%）
# MAX_TEST_RATIO=0.10         # 测试集占比上限
# MAX_SOURCE_SHARE=0.06       # 来源体量超过全库该比例的整户不进测试集（硬约束 vs 比例冲突时的取舍）
# PROBE_SIZE=60               # 种子评估集条数（按主题铺开，不参与 train/test；0=不生成）

# ---- 旧格式文档解析（.doc/.ppt 需要额外后端）----
# SOFFICE_BIN=                # LibreOffice 可执行文件路径，不设则自动探测
# OCR_ENABLED=false           # true 时对「文本过少」的 PDF/图片走 RapidOCR 兜底
# OCR_MIN_CHARS=50            # 解析出的字符数低于该值则判定为扫描件，触发 OCR
# OCR_DPI=200                 # OCR 渲染分辨率

# ---- 路径覆盖（一般无需设置，测试用）----
# RAG_DATA_DIR=               # 原始资料目录，默认 <项目根>/nlp_
# STORE_DIR=                  # 向量库目录，默认 rag/chroma_db
# CACHE_DIR=                  # 缓存目录，默认 rag/cache

# ---- 《数据要素》课程问答管线（rag/course，独立于上面的 LLM_*；胜算云 DeepSeek V4 Pro，OpenAI 兼容协议）----
# COURSE_LLM_API_BASE 无默认值：必须填胜算云的 OpenAI 兼容接口地址，未填会报错
COURSE_LLM_API_BASE=
COURSE_LLM_API_KEY=
COURSE_LLM_MODEL=deepseek/deepseek-v4-pro
# COURSE_SELECT_MODEL=        # Step 1 选词，默认同 COURSE_LLM_MODEL
# COURSE_FILTER_MODEL=        # Step 3 筛选，默认同 COURSE_LLM_MODEL
#   示例（筛选只做分级、不需要强推理，换成更快的 Flash；路由/选概念/作答仍用 pro）：
#   COURSE_FILTER_MODEL=deepseek/deepseek-v4-flash   # 模型名需先在胜算云确认；须支持 response_format=json_object 与 reasoning disabled
# COURSE_ANSWER_MODEL=        # Step 4 作答，默认同 COURSE_LLM_MODEL
# COURSE_LLM_NATIVE_TOOLS=true  # false：不用原生 tools/json_object，改为 prompt 约定 JSON + 本地解析
# COURSE_AGENT_MAX_STEPS=7      # Step 1 最多选词 LLM 调用次数（含最后强制 finish 的一次；7 = 6 次探索 + 1 次 finish）
# COURSE_SELECT_FAST_PATH=false # 实验开关：问题只命中唯一无歧义概念别名时跳过选词 LLM，并补一跳关联概念
# COURSE_FAST_RELATED_MAX=5     # 快速路径最多补入的一跳关联概念数（0=不补）
# COURSE_RECALL_MAX_CHARS=12000 # Step 3 单批子块正文字符上限，超出分批
# COURSE_ANSWER_MAX_CHUNKS=10   # Step 4 最多使用的子块数（先 direct 后 background，同级按与问题的相关分排序）
# 各步骤思考模式（胜算云 reasoning 参数）：disabled / low / medium / high；留空 = 不发送，用模型默认
# COURSE_SELECT_REASONING=disabled   # 选词默认关闭思考（实测默认思考量小、关闭后省约 20% token）；留空=不发送参数，由服务端决定
# COURSE_FILTER_REASONING=disabled
# COURSE_ANSWER_REASONING=low   # 作答保留低强度思考，不要改成 disabled
# COURSE_QUESTION_MAX_CHARS=500  # HTTP 接口 /course/ask 单个问题的字符上限
# COURSE_ONTO_ROOT=             # 本体数据根目录（Ontology_KG，只读）
# COURSE_TEXTBOOK=              # 教材 docx 路径

# ---- 政策库（rag.policy，与课程库 COURSE_* 分开）----
# python -m rag.policy.cli chunk：数据政策汇编按条/事项切块，输出到 POLICY_CACHE_DIR
# POLICY_DOC=                   # 数据政策汇编 docx 路径（默认 rag/policy_data/数据政策汇编.docx）
# POLICY_CACHE_DIR=             # 输出目录（默认 rag/policy_cache）
# POLICY_CHUNK_MAX=1500         # 超过此长度的条/事项才拆开
# POLICY_PART_TARGET=1000
# POLICY_EXCLUDE_TITLES=数据规范  # 标题含这些词的文件不入库（数据字典类标准），逗号分隔

# HTTP concurrency per process (includes SSE streams).
# 超限时先排队等待（RAG_QUEUE_TIMEOUT_S，默认 30s），等到名额就放行；等待超时才回 503 + Retry-After。
# 同步 handler 每请求占一个 anyio 工作线程，启动时线程池上限提到 RAG_THREADPOOL_LIMIT（默认 140，须 ≥ 本值）。
RAG_MAX_CONCURRENT_REQUESTS=100
RAG_QUEUE_TIMEOUT_S=30
RAG_THREADPOOL_LIMIT=140

# ---- 向量化批处理（rag/embedding.py；并发请求的单条 encode 合并成批）----
# 逐条 encode 会让并发请求排队：BGE-m3 在 CPU 上单条 90ms（20 字）～2.7s（2600 字），
# 100 并发就变成一条一条放行。成批后 100 条 20 字实测 9.6s → 2.2s。
# EMBED_WORKERS × EMBED_TORCH_THREADS 要接近核数：8 核建议 2 × 4（默认）；16 核可 2 × 8。
# EMBED_MAX_BATCH=32            # 一批最多几条
# EMBED_MAX_CHARS=6000          # 一批总字数上限（长问题会单独成批，避免被大批拖慢）
# EMBED_BATCH_WAIT_MS=15        # 攒批最多等多久（队列空时立即编码）
# EMBED_WORKERS=2
# EMBED_TORCH_THREADS=4

# ---- 多轮对话（POST /v1/chat/completions）----
# 最多带多少轮历史（user+assistant 算一轮）交给模型；0 = 只答最后一句（旧行为）。
# CHAT_HISTORY_MAX_TURNS=6
# 检索前先用历史把追问改写成独立问题（「第二种具体怎么算」→「数据资产估值的收益法具体怎么算」）。
# 只用于检索，交给模型的仍是原话。CONTEXTUALIZE_TIMEOUT 是这一步的超时（秒），超时退回原问题。
# CONTEXTUALIZE_QUERY_ENABLED=true
# CONTEXTUALIZE_TIMEOUT=8
# 历史总字数上限：从最近一轮往前累加，超出就丢更早的轮次（按整轮丢，不留半截对话）。
# CHAT_HISTORY_MAX_CHARS=8000

# ---- 会话存储（rag/conversation.py；/v1/conversations*）----
# SQLite 文件默认 rag/conversation_db/conversations.sqlite3；该目录已在 .gitignore。
# CONVERSATION_DB=/home/FUTURX/rag/conversation_db/conversations.sqlite3
# 会话保留天数：0 = 永久。到期由 scripts/purge_conversations.py 清理（可用 cron 每天跑一次）。
# CONVERSATION_RETENTION_DAYS=365

# ---- 全局 LLM 路由（统一入口 POST /auto/ask，见 rag/unified.py；留空则复用课程库的胜算云配置）----
# ROUTER_MODEL=deepseek/deepseek-v4-pro
# ROUTER_API_BASE=             # 默认取 COURSE_LLM_API_BASE
# ROUTER_API_KEY=              # 默认取 COURSE_LLM_API_KEY
# ROUTER_REASONING=disabled    # disabled / low / medium / high；路由要快，默认关闭思考
# ROUTER_TIMEOUT=15            # 秒；超时/报错/JSON 解析失败 -> 规则兜底，规则判不了则拒答
# ROUTER_REFUSAL_TEXT=         # 拒答文案（默认说明只回答三类范围）
# ROUTER_POLICY_TEXT=          # 政策库未上线时的占位文案

# ---- 原 RAG 自适应（rag/adaptive.py）----
# ADAPTIVE_MIN_RERANK_SCORE=0.3  # 重排最高分低于它 -> 改写查询重查一次，仍低 -> 「资料不足」
# ADAPTIVE_MAX_DISTANCE=0.6      # 未开重排且为 dense 检索时，用最近邻距离判断；hybrid 无重排则跳过纠错
# ADAPTIVE_MAX_SUBQUESTIONS=3    # complex 问题最多拆几个子问题（上限 3）
# ADAPTIVE_MAX_ROUNDS=2          # complex 检索总轮数硬上限（1~3）

# ---- 课程库兜底召回（选词漏选概念时，教材块不会整块丢失）----
# COURSE_BM25_TOPK=6            # 用问题对教材子块做 BM25（jieba）取 top-k，与本体召回合并去重；0=关闭

# ---- 课程库 Step 1/3 简化（默认 single：路由1 + 选概念1 + 筛选1 + 作答1 = 固定 4 次 LLM 调用）----
# COURSE_SELECT_MODE=single      # single=本地候选+一次选概念（默认）；agent=旧的多轮工具调用
# COURSE_SELECT_CANDIDATES=30    # single 模式候选概念数上限
# COURSE_FILTER_MAX_CHUNKS=40    # 筛选一次调用最多送入的子块数；超出先留本体有证据的块，再按 BM25 分取前若干
# COURSE_FILTER_SKIP_MAX=15      # 召回块数不超过此值时跳过筛选、全部直接作答；0 = 总是筛选

# ---- 试卷库（rag/exam：/auto/ask 的 exam 路由、/exam/* 接口、课程回答后的基础题推荐；不调用 LLM）----
# EXAM_TEACHER_DOC=/path/数据要素流通与数据工程参考答案与评分要点（教师版_2015题_修订版）.docx   # 主来源（含答案）
# EXAM_STUDENT_DOC=/path/数据要素流通与数据工程全题型题库（学生版_2015题_修订版）.docx          # 仅 build 时核对
# EXAM_STUDENT_SET=             # 学生知识集合.xlsx；默认取课程库本体目录下的学生知识集合（9.11 / 11.2 结构自动识别）
# EXAM_CACHE_DIR=rag/exam_cache # build 导出的审阅文件
# EXAM_SEARCH_TOPK=5            # 问题里没说几道题时默认返回题数（上限 10）
# EXAM_PRACTICE_MAX=3           # 课程回答附带的基础题数（0~3），0=不附
# EXAM_BM25_MIN_SCORE=4.0       # BM25 最高分低于它视为题库没有对应题目
# EXAM_BM25_REL=0.6             # 低于最高分该比例的题不要（不凑数）

# ---- 判例库 / 名言库（独立知识库，第一阶段：解析与切块；原始资料不进仓库）----
# CASE_DOC=/path/数据法典型判例库（十章分类完整版）.docx    # 判例库 docx
# CASE_CACHE_DIR=             # 切块输出目录，默认 rag/case_cache（与 chroma_db 等分开）
# CASE_CARD_MAX_CHARS=800     # 卡片正文句末截断上限（卡片头的案名/章节/案号/法院/日期不计）；要点完整原文在正文块里
# CASE_BODY_MIN=800           # 正文块字数下限（太短的小节与相邻小节合并）
# CASE_BODY_MAX=1200          # 正文块字数上限
# QUOTE_DOC=/path/习近平总书记关于数智的有关表述合集.docx   # 名言库 docx
# QUOTE_CACHE_DIR=            # 切块输出目录，默认 rag/quote_cache
# 命令：python -m rag.cases.cli chunk --doc <docx> ；python -m rag.quotes.cli chunk --doc <docx>

# ---- 判例库 / 名言库（第二阶段：向量库、检索、作答；与课程库共用 COURSE_LLM_* 的胜算云配置）----
# CASE_STORE_DIR=             # 判例向量库目录，默认 rag/case_store（绝不能是论文库 rag/chroma_db，建库命令会拒绝）
# CASE_COLLECTION=data_law_cases
# QUOTE_STORE_DIR=            # 名言向量库目录，默认 rag/quote_store
# QUOTE_COLLECTION=xi_digital_quotes
# CASE_FETCH_CHUNKS=30        # 判例：一次向量检索取多少块再按案聚合
# CASE_MAX_BODY_CHUNKS=3      # 判例：每案最多送几个正文块给作答（另有 1 张卡片）
# QUOTE_FETCH=8               # 名言：一次检索取多少次讲话
# 建库（在服务器上执行，调用 LLM 次数为 0，只用 BGE-m3 做向量化）：
#   python -m rag.cases.cli chunk  --doc <判例库.docx>      # 先切块 -> rag/case_cache/
#   python -m rag.quotes.cli chunk --doc <名言合集.docx>    # 先切块 -> rag/quote_cache/
#   python -m rag.kbbuild cases  --dry-run                  # 先干跑校验
#   python -m rag.kbbuild cases   ;  python -m rag.kbbuild quotes
